# ─────────────────────────────────────────────
#  Offline AI Knowledge Hub — Environment Config
#  Copy to .env and fill in values before starting
# ─────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────
POSTGRES_USER=knowledge_user
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=knowledge_hub
DATABASE_URL=postgresql+asyncpg://knowledge_user:changeme_strong_password@postgres:5432/knowledge_hub

# ── JWT Auth ──────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_key_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Ollama (Local LLM) ───────────────────────
OLLAMA_BASE_URL=http://ollama:11434
# Options: qwen2.5:7b-instruct | llama3.1:8b | mistral:7b | phi4 | gemma3
OLLAMA_MODEL=qwen2.5:7b-instruct

# ── Embeddings (SentenceTransformers) ────────
# Model is downloaded to HuggingFace cache on first backend start
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# Fallback: nomic-embed-text (via Ollama)
EMBEDDING_FALLBACK_MODEL=nomic-embed-text

# ── ChromaDB ──────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_PERSIST_DIR=/chroma_data

# ── File Storage ──────────────────────────────
UPLOAD_TEMP_DIR=/uploads/temp

# ── RAG / Chunking ───────────────────────────
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K=5

# ── Whisper (Local Speech-to-Text) ───────────
# Options: tiny | base | small | medium | large-v3
# base recommended for 16GB RAM / CPU-only
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
# Set to cuda if GPU is available
# WHISPER_DEVICE=cuda

# ── Backend ───────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=production
LOG_LEVEL=info

# ── HuggingFace Cache ─────────────────────────
# Embedding model is stored here — persisted via Docker volume
HF_HOME=/hf_cache
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1
